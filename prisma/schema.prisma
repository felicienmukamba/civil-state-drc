generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  password_hash String
  role          String    @default("OFFICIER")
  actif         Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  registered_marriages Marriage[]
  registered_divorces  Divorce[]
}

model Citizen {
  id               Int       @id @default(autoincrement())
  numero_national  String    @unique
  nom              String
  postnom          String
  prenom           String
  date_naissance   DateTime
  lieu_naissance   String
  sexe             String
  profession       String
  adresse_actuelle String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  marriagesAsEpoux  Marriage[] @relation("epoux_relation")
  marriagesAsEpouse Marriage[] @relation("epouse_relation")

  @@index([nom])
  @@index([numero_national])
}

model Marriage {
  id                 Int       @id @default(autoincrement())
  numero_acte        String    @unique
  date_celebration   DateTime
  lieu_celebration   String
  regime_matrimonial String
  
  epoux_id           Int
  epoux              Citizen   @relation("epoux_relation", fields: [epoux_id], references: [id])
  
  epouse_id          Int
  epouse             Citizen   @relation("epouse_relation", fields: [epouse_id], references: [id])
  
  officier_id        Int
  officier           User      @relation(fields: [officier_id], references: [id])
  
  divorce            Divorce?
  
  status             String    @default("BROUILLON")

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@index([numero_acte])
  @@index([date_celebration])
}

model Divorce {
  id                   Int       @id @default(autoincrement())
  numero_acte          String    @unique
  date_enregistrement  DateTime
  decision_justice_ref String
  motif                String
  
  mariage_id           Int       @unique
  mariage              Marriage  @relation(fields: [mariage_id], references: [id])
  
  officier_id          Int
  officier             User      @relation(fields: [officier_id], references: [id])

  status               String    @default("BROUILLON")

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  entity    String
  summary   String
  actor     String
  createdAt DateTime @default(now())
}
